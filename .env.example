# ==============================================================================
# PMI Portfolio Content Request Management System
# Production Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Owner Bootstrap Authentication
# Initial bootstrap password used on first run only. Must be changed in the Owner Portal.
INITIAL_OWNER_PASSWORD=owner@pmi2026
INITIAL_OWNER_USERNAME=admin

# Session & Security
# Cryptographically secure random session signing secret (minimum 32 characters)
SESSION_SECRET=change-this-to-a-cryptographically-random-secret-in-production
COOKIE_SECURE=false

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
MAX_TOTAL_UPLOAD_SIZE_MB=25

# Database Configuration
DATABASE_PATH=./database.sqlite

# Cloudflare Tunnel Auto-Start (true | false)
ENABLE_CLOUDFLARE_TUNNEL=true

